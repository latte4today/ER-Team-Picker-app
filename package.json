{
  "name": "eternal-return-team-picker",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "Desktop app for Eternal Return team composition recommendations.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "cmd /d /s /c start \"\" \"%CD%\\node_modules\\electron\\dist\\electron.exe\" --no-sandbox \"%CD%\"",
    "app": "cmd /d /s /c start \"\" \"%CD%\\node_modules\\electron\\dist\\electron.exe\" --no-sandbox \"%CD%\"",
    "collect-dak": "\"C:\\Program Files\\nodejs\\node.exe\" tools/dak_collector.mjs --rankers 200 --matchesPerRanker 12",
    "collect-official": "node tools/official_collector.mjs",
    "collect-official-seeds": "node tools/official_seed_collector.mjs",
    "build-official-stats": "node tools/build_official_stats.mjs",
    "archive-official-matches": "node tools/archive_official_matches.mjs",
    "materialize-official-archive": "node tools/materialize_archive_corpus.mjs --archive-dir data/external/ER-Team-Picker-data/official-archive --out reports/generated/latest-official-archive.jsonl",
    "backtest-latest-archive": "node tools/backtest_latest_archive.mjs",
    "ceiling-latest-archive": "node tools/backtest_latest_archive.mjs --ceiling",
    "analyze-composition-interactions": "python tools/analyze_composition_interactions.py",
    "audit-archive-duplicates": "python tools/audit_archive_duplicates.py",
    "migrate-archive-dedup": "python tools/migrate_archive_dedup.py",
    "test-archive-dedup": "node tools/test_archive_dedup.mjs",
    "build-official-summary": "node tools/build_official_summary.mjs",
    "build-official-compact-from-archive": "node tools/build_compact_from_archive.mjs",
    "build-compact-stats": "node tools/build_compact_stats.mjs",
    "build-empirical-spectrum": "node tools/build_empirical_spectrum_report.mjs",
    "build-pair-synergy-lift": "node tools/pair_synergy_lift.mjs --out src/pairSynergyLift.js",
    "check-pair-synergy-lift": "node tools/check_pair_synergy_lift.mjs --min 40 --max-fdr 0.1",
    "build-pair-role-stats": "node tools/build_pair_role_stats.mjs --in src/officialMatchStats.compact.json --out src/pairRoleStats.js --min-games 60 --min-candidates 2",
    "check-pair-role-stats": "node tools/check_pair_role_stats.mjs",
    "export-ml-training-data": "node tools/export_ml_training_data.mjs",
    "discover-official-data": "node tools/discover_official_data_tables.mjs",
    "inspect-trait-mapping": "node tools/inspect_trait_mapping.mjs",
    "check-api-key": "node tools/check_api_key.mjs",
    "test-official-api": "node tools/test_api.mjs",
    "snapshot-recommendations": "node tools/recommendation_snapshot.mjs",
    "snapshot-recommendations:update": "node tools/recommendation_snapshot.mjs --update",
    "perf-recommendations": "node tools/measure_recommend_performance.mjs",
    "wiki-template": "\"C:\\Program Files\\nodejs\\node.exe\" tools/make_wiki_metrics_template.mjs",
    "wiki-apply": "\"C:\\Program Files\\nodejs\\node.exe\" tools/apply_wiki_metrics_csv.mjs",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "clean-build": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"foreach ($path in @('dist','release')) { if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Recurse -Force } }\"",
    "package-win": "npm run clean-build && electron-builder --dir",
    "installer-win": "npm run clean-build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.er.team-picker",
    "productName": "ER Team Picker",
    "artifactName": "ER-Team-Picker-Setup-${version}.${ext}",
    "files": [
      "index.html",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "supabase/**/*",
      "README.md"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "latte4today",
        "repo": "ER-Team-Picker-app"
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ER Team Picker",
      "deleteAppDataOnUninstall": false,
      "include": "installer/custom.nsh"
    }
  }
}
